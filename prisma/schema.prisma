generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetToken        String?
  resetTokenExpiry  DateTime?

  profile      Profile?
  patients     Patient[]
  reports      Report[]
  measurements HealthMeasurement[]
  reminders    Reminder[]
  shareLinks   ShareLink[]
  exports      ExportLog[]
  auditLogs    AuditLogRoleAccess[]
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dob        String?
  gender     String?
  height     Float?
  weight     Float?
  bloodGroup String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Patient {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  dob             DateTime?
  gender          String?
  bloodGroup      String?
  photoUrl        String?
  phone           String?
  email           String?
  address         String?
  emergencyContact String?
  height          Float?
  weight          Float?
  allergies       String?
  conditions      String?
  medications     String?
  surgeries       String?
  familyHistory   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reports          Report[]
  measurements     HealthMeasurement[]
  referenceRanges  ReferenceRange[]
  reminders        Reminder[]
  shareLinks       ShareLink[]
  exports          ExportLog[]
  auditLogs        AuditLogRoleAccess[]
}

model Report {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title          String
  reportType     String?
  laboratoryName String?
  labLocation    String?
  doctorName     String?
  reportDate     DateTime?
  patientName    String?
  reportNumber   String?
  fileName       String
  filePath       String
  fileType       String
  fileSize       Int
  pageCount      Int?
  language       String     @default("en")
  parsedText     String?
  processingStatus String  @default("confirmed")
  processingError  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  results   LabResult[]
  auditLogs AuditLogRoleAccess[]
}

model LabResult {
  id               String    @id @default(cuid())
  reportId         String
  report           Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  canonicalName    String
  originalTestName String
  originalValue    String
  originalUnit     String?
  normalizedValue  Float?
  normalizedUnit   String?
  referenceLow     Float?
  referenceHigh    Float?
  originalRefRange String?
  flag             String?
  resultDate       DateTime?
  confidence       String    @default("medium")
  confirmed        Boolean   @default(false)
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs AuditLogRoleAccess[]

  @@index([reportId, canonicalName])
}

model HealthMeasurement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      String
  value     Float
  unit      String?
  note      String?
  date      DateTime @default(now())
  category  String   @default("vitals")
  source    String   @default("manual")
  deviceName String?
  createdAt DateTime @default(now())

  @@index([patientId, type])
}

model ReferenceRange {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  biomarker     String
  lower         Float?
  upper         Float?
  unit          String?
  source        String    @default("standard")
  sourceDetail  String?
  gender        String?
  ageMin        Int?
  ageMax        Int?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([patientId, biomarker])
}

model Reminder {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testName   String
  date       DateTime
  recurrence String   @default("none")
  notes      String?
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([patientId, status])
}

model ShareLink {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  token          String    @unique
  label          String?
  includeReports  Boolean  @default(true)
  includeResults  Boolean  @default(true)
  includeVitals   Boolean  @default(false)
  includeDetails  Boolean  @default(false)
  includeTimeline Boolean  @default(false)
  includeInsights Boolean  @default(false)
  expiresAt      DateTime?
  revoked        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)

  auditLogs AuditLogRoleAccess[]

  @@index([patientId])
  @@index([revoked])
}

model ExportLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  format    String
  scope     String   @default("full")
  createdAt DateTime @default(now())
}

model AuditLogRoleAccess {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientId String?
  patient   Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  reportId  String?
  report    Report?   @relation(fields: [reportId], references: [id], onDelete: SetNull)
  resultId  String?
  result    LabResult? @relation(fields: [resultId], references: [id], onDelete: SetNull)
  shareId   String?
  share     ShareLink? @relation(fields: [shareId], references: [id], onDelete: SetNull)
  action    String
  detail    String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([patientId])
  @@index([action])
}